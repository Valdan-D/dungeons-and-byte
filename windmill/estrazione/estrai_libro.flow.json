{
 "workspace_id": "dnb",
 "path": "f/estrazione/estrai_libro",
 "summary": "Estrazione - LoRA sui blocchi etichettati",
 "description": "Per un libro gia' etichettato: sceglie i LoRA (bestiario new/old dall'anno nel nome), costruisce le finestre dai blocchi etichettati e lancia i LoRA uno alla volta sulla GPU, poi raccoglie le entita' in <progetto>/estrazione/entita.json. Rifiuta se la GPU e' occupata o l'OCR e' attivo. Se si rilancia riprende da dove si era fermato (spunta 'ricostruisci' per rifare le finestre: i risultati vecchi vengono messi da parte).",
 "value": {
  "modules": [
   {
    "id": "a",
    "value": {
     "path": "f/estrazione/scegli_lora",
     "type": "script",
     "input_transforms": {
      "progetto": {
       "expr": "(typeof flow_input.progetto === 'object' && flow_input.progetto !== null) ? flow_input.progetto.value : flow_input.progetto",
       "type": "javascript"
      },
      "bestiario": {
       "expr": "flow_input.bestiario",
       "type": "javascript"
      },
      "tipologie": {
       "expr": "flow_input.tipologie",
       "type": "javascript"
      }
     }
    },
    "summary": "Sceglie i LoRA (bestiario new/old dall'anno)"
   },
   {
    "id": "b",
    "value": {
     "type": "forloopflow",
     "modules": [
      {
       "id": "b1",
       "value": {
        "path": "f/estrazione/prepara_finestre",
        "type": "script",
        "input_transforms": {
         "progetto": {
          "expr": "(typeof flow_input.progetto === 'object' && flow_input.progetto !== null) ? flow_input.progetto.value : flow_input.progetto",
          "type": "javascript"
         },
         "tipologia": {
          "expr": "flow_input.iter.value.tipologia",
          "type": "javascript"
         },
         "ricostruisci": {
          "expr": "flow_input.ricostruisci === true",
          "type": "javascript"
         }
        }
       },
       "summary": "Costruisce le finestre"
      },
      {
       "id": "b2",
       "value": {
        "path": "f/estrazione/esegui_lora",
        "type": "script",
        "input_transforms": {
         "progetto": {
          "expr": "(typeof flow_input.progetto === 'object' && flow_input.progetto !== null) ? flow_input.progetto.value : flow_input.progetto",
          "type": "javascript"
         },
         "tipologia": {
          "expr": "flow_input.iter.value.tipologia",
          "type": "javascript"
         },
         "n_finestre": {
          "expr": "results.b1.finestre",
          "type": "javascript"
         },
         "ore_massime": {
          "expr": "12",
          "type": "javascript"
         }
        }
       },
       "summary": "Lancia il LoRA e aspetta",
       "timeout": {
        "type": "static",
        "value": 46800
       }
      }
     ],
     "iterator": {
      "expr": "results.a.lora",
      "type": "javascript"
     },
     "parallel": false,
     "skip_failures": false
    },
    "summary": "Un LoRA alla volta"
   },
   {
    "id": "c",
    "value": {
     "path": "f/estrazione/riepilogo_estrazione",
     "type": "script",
     "input_transforms": {
      "progetto": {
       "expr": "(typeof flow_input.progetto === 'object' && flow_input.progetto !== null) ? flow_input.progetto.value : flow_input.progetto",
       "type": "javascript"
      }
     }
    },
    "summary": "Raccoglie le entita' e riassume"
   }
  ]
 },
